# Google Earth Engine login for tomer_peled_mgi_thesis.config. Copy this file to .env in the
# project root; config.py loads it (real environment variables take precedence). Leave unset to use the project
# stored by `earthengine authenticate`.
EE_PROJECT=your-gee-cloud-project-id
# Optional service-account login (key file stays outside Git):
# EE_SERVICE_ACCOUNT_EMAIL=name@project.iam.gserviceaccount.com
# EE_SERVICE_ACCOUNT_KEY_FILE=C:/path/to/key.json
