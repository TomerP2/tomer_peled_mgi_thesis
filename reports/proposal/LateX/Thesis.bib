	publisher = {Copernicus GmbH},
	author = {Lesiv, Myroslava and Fritz, Steffen and Dürauer, Martina and Georgieva, Ivelina and Buchhorn, Marcel and Bertels, Luc and Tsendbazar, Nandika and Van De Kerchove, Ruben and Zanaga, Daniele and Schepaschenko, Dmitry and See, Linda and Herold, Martin and Smets, Bruno and Cherlet, Michael and Brink, Andreas and McCallum, Ian},
	month = nov,
