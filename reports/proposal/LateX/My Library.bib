@article{landuytFloodMappingBased2019,
	title = {Flood {Mapping} {Based} on {Synthetic} {Aperture} {Radar}: {An} {Assessment} of {Established} {Approaches}},
	volume = {57},
	issn = {1558-0644},
	shorttitle = {Flood {Mapping} {Based} on {Synthetic} {Aperture} {Radar}},
	url = {https://ieeexplore.ieee.org/abstract/document/8432448},
	doi = {10.1109/TGRS.2018.2860054},
	abstract = {In our changing world, floods are a threat of increasing concern. Within this context, flood mapping is important for both damage assessment and forecast improvement. Due to the suitability of synthetic aperture radar (SAR) for flood mapping, a broad range of SAR-based flood mapping algorithms has been developed during the past years. However, most of these algorithms were presented based on a single test case only and comparisons between methods are rare. This paper presents an in-depth assessment and comparison of the established pixel-based flood mapping approaches, including global and enhanced thresholding, active contour modeling and change detection. The methods were tested on medium-resolution SAR images of different flood events and lakes across the U.K. and Ireland and were evaluated on both accuracy and robustness. Results indicate that the most suited method depends on the area of interest and its characteristics as well as the intended use of the observation product. Due to its high robustness and good performance, tiled thresholding is suited for automated, near-real time flood detection and monitoring. Active contour models can provide higher accuracies but require long computation times that strongly increase with increasing image sizes, making them more appropriate for accurate flood mapping in smaller areas of interest.},
	number = {2},
	urldate = {2026-01-20},
	journal = {IEEE Transactions on Geoscience and Remote Sensing},
	author = {Landuyt, Lisa and Van Wesemael, Alexandra and Schumann, Guy J.-P. and Hostache, Renaud and Verhoest, Niko E. C. and Van Coillie, Frieke M. B.},
	month = feb,
	year = {2019},
	keywords = {Active contours, change detection, Entropy, flood mapping, Floods, Histograms, Standards, Synthetic aperture radar, synthetic aperture radar (SAR), thresholding, Urban areas},
	pages = {722--739},
	file = {Full Text PDF:C\:\\Users\\tomer\\Zotero\\storage\\K37DP9AY\\Landuyt et al. - 2019 - Flood Mapping Based on Synthetic Aperture Radar An Assessment of Established Approaches.pdf:application/pdf},
}

@article{liAutomaticChangeDetection2018,
	title = {An automatic change detection approach for rapid flood mapping in {Sentinel}-1 {SAR} data},
	volume = {73},
	issn = {1569-8432},
	url = {https://www.sciencedirect.com/science/article/pii/S0303243418302782},
	doi = {10.1016/j.jag.2018.05.023},
	abstract = {In this paper, a two-step automatic change detection chain for rapid flood mapping based on Sentinel-1 Synthetic Aperture Radar (SAR) data is presented. First, a reference image is selected from a set of potential image candidates via a Jensen-Shannon (JS) divergence-based index. Second, saliency detection is applied on log-ratio data to derive the prior probabilities of changed and unchanged classes for initializing the following expectation-maximization (EM) based generalized Gaussian mixture model (GGMM). The saliency-guided GGMM is capable of capturing the primary pixel-based change information and handling highly imbalanced datasets. A fully-connected conditional random field (FCRF) model, which takes long-range pairwise potential connections into account, is integrated to remove the ambiguities of the saliency-guided GGMM and to achieve the final change map. The whole process chain is automatic with an efficient computation. The proposed approach was validated on flood events at the Evros River, Greece and the Wharfe River and Ouse River in York, United Kingdom. Kappa coefficients (k) of 0.9238 and 0.8682 were obtained respectively. The sensitivity analysis underlines the robustness of the proposed approach for rapid flood mapping.},
	urldate = {2026-01-20},
	journal = {International Journal of Applied Earth Observation and Geoinformation},
	author = {Li, Yu and Martinis, Sandro and Plank, Simon and Ludwig, Ralf},
	month = dec,
	year = {2018},
	keywords = {Floods, Change detection, Fully-connected conditional random field, Generalized Gaussian mixture model, Saliency detection},
	pages = {123--135},
