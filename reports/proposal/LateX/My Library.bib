@article{slompImprovingGlobalLand2025,
	title = {Improving global land cover fraction change mapping using temporal deep learning},
	volume = {144},
	issn = {1569-8432},
	url = {https://www.sciencedirect.com/science/article/pii/S1569843225005746},
	doi = {10.1016/j.jag.2025.104927},
	abstract = {Monitoring land cover changes becomes increasingly vital in light of climate change and urban and industrial expansion. Land cover, however, is often expressed in discrete categories, which can oversimplify transitional and heterogeneous areas. Instead, by mapping land cover types as fractions, one can make a more accurate representation of not only the spatial distribution but also the temporal variability, which is crucial for pronounced change detection. However, current methods produce inconsistent time series or oversimplify change dynamics. At the same time, the promising potential of temporal deep learning and dense time series modelling has not been previously explored. Bridging this gap, this study compares novel Long Short-Term Memory (LSTM) and post-processing LSTM (PostLSTM) models with baseline Random Forest (RF) and Markov Chain models for multi-class land cover fraction regression and post-processing, respectively. Landsat-8 data were used to produce fraction time series at a 100-meter spatial resolution in both annual and, in a novel approach harnessing intra-annual characteristics, dense (16-day) time steps. The models were trained and validated using yearly land cover fraction records collected from globally distributed sample sites. The LSTM models performed better than the RF models when focusing on land cover classes predicted or validated to have a fraction of at least 1\%. However, they did not outperform because of poorer handling of the remaining 0\% fractions, which are naturally inflated in number since the majority of classes are commonly absent from a given area. Since the RF models produced fluctuating time series, the PostLSTM models achieved the highest yearly Overall Accuracy (OA) ({\textgreater}67\%). Compared to the Markov Chain models constrained by their Markov property, the PostLSTM models stabilised time series while preserving actual change. All dense models achieved similar yearly OA to their annual counterparts, but can offer end-users valuable information on intra-annual land cover fraction change. This research showcases the potential of temporal deep learning and provides important new insights into increasing accuracy in annual and dense land cover fraction mapping.},
	urldate = {2026-10-13},
	journal = {International Journal of Applied Earth Observation and Geoinformation},
	author = {Slomp, August and Masiliūnas, Dainius and Tsendbazar, Nandin-Erdene},
	month = nov,
	year = {2025},
	keywords = {Random forest, Deep learning, Dense time series, Land cover fractions, Long short-term memory, Markov chain},
	pages = {104927},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\tomer\\Zotero\\storage\\EDFD8IVB\\Slomp et al. - 2025 - Improving global land cover fraction change mapping using temporal deep learning.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\tomer\\Zotero\\storage\\8J3GQLFZ\\S1569843225005746.html:text/html},
}

